# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# .claude/**
specs/**

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test p
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/
node_modules/

# Playwright browser-test artifacts
playwright-report/
test-results/
blob-report/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Config file
config.toml 

# Local buffer
beacon.db

# Artifacts
/beacon

# Tailwind/daisyUI standalone CLI + plugin bundles (dev-time download, not
# source); see internal/ui/uisrc/README.md to re-fetch.
/internal/ui/uisrc/build/

# Editor/IDE
# .idea/
# .vscode/
*.db-wal
*.db-shm
.claude/

# impeccable design hook: design.json is shared config (committed); the
# cache, per-user consent, and live-session state are local only.
.impeccable/hook.cache.json
.impeccable/config.local.json
.impeccable/live/
